# Local dev (Docker):
#   docker run -d --name qualcode-pg -e POSTGRES_PASSWORD=qualcode -e POSTGRES_USER=qualcode \
#     -e POSTGRES_DB=qualcode -p 55432:5432 postgres:16-alpine
POSTGRES_URL=postgres://qualcode:qualcode@localhost:55432/qualcode

# Production: use the POOLED connection string from the Neon integration on Vercel.
# It looks like: postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign the coder session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=dev-only-insecure-secret-change-me
