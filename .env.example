# ---------------------------------------------------------------------------
# Connection string. Any ONE of these names is enough; they are tried in order:
#   POSTGRES_URL, DATABASE_URL            (pooled — preferred)
#   POSTGRES_URL_NON_POOLING, DATABASE_URL_UNPOOLED   (direct — fallback)
#
# A namespaced form is also accepted, so a Vercel integration configured with a
# prefix (`qual_POSTGRES_URL`, `qual_AUTH_SECRET`, …) works without any change.
#
# Define the SAME name only once. Later definitions in a .env file override
# earlier ones, so a leftover local URL below a hosted one is silently ignored.
# ---------------------------------------------------------------------------

# Local dev (Docker):
#   docker run -d --name qualcode-pg -e POSTGRES_PASSWORD=qualcode -e POSTGRES_USER=qualcode \
#     -e POSTGRES_DB=qualcode -p 55432:5432 postgres:16-alpine
POSTGRES_URL=postgres://qualcode:qualcode@localhost:55432/qualcode

# Production: paste the whole .env block the Neon integration gives you. Use the
# POOLED string — its host contains `-pooler`. The direct endpoint runs out of
# connections under serverless.

# Secret used to sign the coder session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=dev-only-insecure-secret-change-me
